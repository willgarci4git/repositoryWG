# Copie este arquivo para ".env" e preencha com seus valores reais.
# .env nunca deve ser commitado no git (já está no .gitignore).

# Token do bot do Telegram, obtido com o @BotFather (ex: 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=

# ID do chat que vai receber os alertas (seu chat pessoal com o bot, ou um grupo)
TELEGRAM_CHAT_ID=

# Webhook do canal do Discord (opcional — deixe em branco se não usar Discord).
# Criar: no Discord, Configurações do canal > Integrações > Webhooks > Novo
# Webhook > Copiar URL do Webhook.
DISCORD_WEBHOOK_URL=
